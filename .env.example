# LLM
OPENAI_API_KEY=
HIPPO_MODEL=gpt-4o-mini
HIPPO_DEMO_MODEL=gpt-4o

# OpenRouter (DeepSeek and other OpenAI-compatible models). HIPPO_PROVIDER=auto picks
# openrouter when the model slug looks like "vendor/model" (e.g. deepseek/deepseek-v4-flash-0731)
# or when only OPENROUTER_API_KEY is set; force with openai|openrouter. HIPPO_BASE_URL overrides
# the endpoint for any other OpenAI-compatible server.
OPENROUTER_API_KEY=
HIPPO_PROVIDER=auto
HIPPO_BASE_URL=

# Tool exposure: all (bind every tool), search (tool_search -> tool_load -> call),
# search-schema (tool_search loads its hits at once). HIPPO_TOOL_ALWAYS_ON: comma-separated
# short tool names bound in every mode (empty = worker baseline read tools).
HIPPO_TOOL_EXPOSURE=all
HIPPO_TOOL_RETRIEVER=keyword
HIPPO_TOOL_SEARCH_K=5
HIPPO_TOOL_ALWAYS_ON=

# Prices in USD per 1M tokens for `hippo bench` cost_usd (0 = tokens only). OpenRouter reports
# billed cost directly, so these are only the fallback. deepseek/deepseek-v4-flash-0731 on
# 2026-09-22: input 0.04, cached input 0.016, output 0.64.
HIPPO_PRICE_INPUT=0
HIPPO_PRICE_CACHED_INPUT=0
HIPPO_PRICE_OUTPUT=0

# Memory: auto = Seahorse if SEAHORSE_API_KEY is set, else local Chroma. Or force seahorse|chroma.
# Note: Seahorse needs a key with WRITE permission to create tables and store memories.
HIPPO_MEMORY_BACKEND=auto
SEAHORSE_API_KEY=
SEAHORSE_TABLE_EPISODES=hippo_episodes
SEAHORSE_TABLE_FACTS=hippo_facts

# Runtime
HIPPO_TOKEN_BUDGET=8000
HIPPO_DATA_DIR=.hippo
HIPPO_WORKSPACE=.
