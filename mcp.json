{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "git": {
      "command": "python",
      "args": ["-m", "mcp_server_git", "--repository", "${GIT_ROOT}"]
    },
    "memory": {
      "command": "python",
      "args": ["-m", "hippo.mcp_server"]
    }
  }
}
